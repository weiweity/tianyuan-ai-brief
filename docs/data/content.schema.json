{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TianyuanBriefContent",
  "type": "object",
  "required": ["version", "decisionSchemaVersion", "meta", "tabs"],
  "properties": {
    "version": { "type": "string" },
    "decisionSchemaVersion": {
      "type": "integer",
      "minimum": 1,
      "description": "本机会议状态兼容边界；结构性变更时递增"
    },
    "ssot": { "type": "string" },
    "updated": { "type": "string" },
    "publishStamp": { "type": "string", "description": "Hot-reload fingerprint seed; set on each save" },
    "meta": {
      "type": "object",
      "required": ["title", "logo"],
      "properties": {
        "title": { "type": "string" },
        "from": { "type": "string" },
        "to": { "type": "string" },
        "subtitle": { "type": "string" },
        "logo": { "type": "string" },
        "logoDataUrl": { "type": "string" },
        "brand": { "type": "string" },
        "roleLine": { "type": "string" },
        "footerLeft": { "type": "string" },
        "footerRight": { "type": "string" }
      }
    },
    "tabs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "blocks"],
        "properties": {
          "id": { "type": "string", "pattern": "^t[1-9]$" },
          "no": { "type": "string" },
          "title": { "type": "string" },
          "layout": { "enum": ["stack", "split", "fill"] },
          "blocks": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "type"],
              "properties": {
                "id": { "type": "string" },
                "type": {
                  "enum": [
                    "callout",
                    "kv-table",
                    "gate-table",
                    "check-table",
                    "mermaid",
                    "image",
                    "do-dont",
                    "detail-card"
                  ]
                },
                "slot": { "enum": ["main", "side"] },
                "variant": { "type": "string" },
                "html": { "type": "string" },
                "source": { "type": "string" },
                "compactItems": {
                  "type": "array",
                  "maxItems": 6,
                  "items": {
                    "type": "object",
                    "required": ["label", "text"],
                    "properties": {
                      "label": { "type": "string" },
                      "text": { "type": "string" },
                      "tone": { "enum": ["ok", "info", "warn", "danger"] }
                    },
                    "additionalProperties": false
                  }
                },
                "src": { "type": "string" },
                "alt": { "type": "string" },
                "headers": { "type": "array", "items": { "type": "string" } },
                "rows": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "rowId": { "type": "string" },
                      "no": { "type": "string" },
                      "checked": { "type": "boolean" },
                      "html": { "type": "string" },
                      "tier": { "enum": ["must", "later"] },
                      "kind": { "enum": ["fee", "owner", "stop-authority"] },
                      "projectId": { "type": "string" },
                      "projectLabel": { "type": "string" },
                      "pathOptions": {
                        "type": "array",
                        "items": { "enum": ["A", "B", "C"] },
                        "uniqueItems": true
                      },
                      "pathValue": { "enum": ["", "A", "B", "C"] },
                      "feeFields": {
                        "type": "object",
                        "required": ["total", "monthCap", "allCap"],
                        "properties": {
                          "total": { "type": "string" },
                          "monthCap": { "type": "string" },
                          "allCap": { "type": "string" },
                          "otherNote": { "type": "string" }
                        }
                      },
                      "owners": {
                        "type": "array",
                        "minItems": 1,
                        "maxItems": 3,
                        "items": {
                          "type": "object",
                          "required": ["name", "dept", "scope"],
                          "properties": {
                            "name": { "type": "string" },
                            "dept": { "type": "string" },
                            "scope": { "type": "string" }
                          }
                        }
                      }
                    }
                  }
                },
                "keyWidth": { "type": "string" },
                "label": { "type": "string" },
                "title": { "type": "string" },
                "subtitle": { "type": "string" },
                "defaultOpen": { "type": "boolean" },
                "dontTitle": { "type": "string" },
                "doTitle": { "type": "string" },
                "dont": { "type": "array", "items": { "type": "string" } },
                "do": { "type": "array", "items": { "type": "string" } }
              }
            }
          }
        }
      }
    }
  }
}
