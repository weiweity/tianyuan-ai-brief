{
  "name": "tianyuan-ai-decision-brief",
  "version": "5.24.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <26",
    "npm": ">=11 <12"
  },
  "scripts": {
    "build:web": "node scripts/build-web.mjs",
    "build:check": "node scripts/build-web.mjs --check",
    "preserve": "npm run build:web",
    "serve": "python3 -m http.server 8765 -d docs",
    "pretest": "npm run build:check",
    "test": "node --test tests/*.test.mjs",
    "test:ui": "node tests/ui-audit.mjs",
    "audit:deps": "npm audit --registry=https://registry.npmjs.org",
    "test:all": "npm run test && npm run test:ui && npm run audit:deps"
  },
  "devDependencies": {
    "ajv": "8.20.0",
    "axe-core": "4.12.1",
    "dompurify": "3.4.12",
    "esbuild": "0.28.1",
    "jsdom": "29.1.1",
    "mermaid": "11.16.0",
    "playwright": "1.62.0"
  }
}
